{% extends "layout.njk" %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from 'moj/components/date-picker/macro.njk' import mojDatePicker %}

{% set pageTitle = "Suspension start date - Activities - DPS" %}
{% set pageId = 'suspend-from-page' %}
{% set jsBackLink = true %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-xl">Manage suspensions</span>
            <h1 class='govuk-heading-l'>
                {% if suspendJourney.allocations | length == 1 %}
                    When does {{ suspendJourney.inmate.prisonerName | safe }}'s suspension from {{ suspendJourney.allocations[0].activityName | safe }} start?
                {% else %}
                    When does {{ suspendJourney.inmate.prisonerName | safe }}'s suspension start?
                {% endif %}
            </h1>

            <form method="POST">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                {{ govukRadios({
                    name: "datePresetOption",
                    errorMessage: validationErrors | findError('datePresetOption'),
                    items: [
                        {
                            value: "immediately",
                            text: "Immediately",
                            hint: {
                                text: "Unlock and movement lists for later today may need to be printed again."
                            },
                            checked: formResponses.datePresetOption == 'immediately' or suspendJourney.suspendFrom == now | toDateString
                        },
                        {
                            value: "tomorrow",
                            text: "Tomorrow",
                            checked: formResponses.datePresetOption == 'tomorrow' or suspendJourney.suspendFrom == now | addDays(1) | toDateString
                        },
                        {
                            value: "other",
                            text: "On another date",
                            checked: formResponses.datePresetOption == 'other' or suspendJourney.suspendFrom > now | addDays(1) | toDateString,
                            conditional: {
                                html: mojDatePicker({
                                    id: 'date',
                                    name: 'date',
                                    leadingZeros: 'true',
                                    hint: {
                                        text: 'Enter the date, for example ' + exampleDatePickerDate() + ', or click on the calendar to select.'
                                    },
                                    classes: 'moj-datepicker--fixed-width',
                                    errorMessage: validationErrors | findError('date'),
                                    value: formResponses.date or suspendJourney.suspendFrom | isoDateToDatePickerDate
                                })
                            }
                        }
                    ]
                }) }}

                {% if suspendJourney.allocations | length > 1 %}
                    {% set activitiesHtml %}
                        {% set rows = [] %}
                        {% for allocation in suspendJourney.allocations | sortBy('activityName') %}
                            {% set rows = (rows.push(
                                {
                                    value: { text: allocation.activityName }
                                }
                            ), rows) %}
                        {% endfor %}

                        {{ govukSummaryList({
                            classes: 'govuk-summary-list--no-keys',
                            rows: rows
                        }) }}
                    {% endset %}

                    {{ govukDetails({
                        summaryText: suspendJourney.inmate.prisonerName + " will be suspended from " + suspendJourney.allocations | length + " activities",
                        html: activitiesHtml
                    }) }}
                {% endif %}

                <div class='govuk-button-group'>
                    {{ govukButton({ text: "Continue"}) }}
                    {% if not session.req.query.preserveHistory %}
                        <a class="govuk-link govuk-link--no-visited-state" href="/activities/suspensions/prisoner/{{ suspendJourney.inmate.prisonerNumber }}">Cancel and return to the prisoner's activities</a>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>
{% endblock %}
