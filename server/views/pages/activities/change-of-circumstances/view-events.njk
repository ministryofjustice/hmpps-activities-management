{% extends "layout.njk" %}

{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "moj/components/pagination/macro.njk" import mojPagination %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "components/sticky-select.njk" import stickySelect %}
{% from "partials/showProfileLink.njk" import showProfileLink %}
{% from "partials/statusBasedCellLocation.njk" import statusBasedCellLocation %}

{% set pageTitle = "Changes in circumstances - Activities - DPS" %}
{% set pageId = 'change-of-circumstance-page' %}
{% set jsBackLink = true %}

{% block content %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl">Changes in circumstances</h1>

        {% set rows = [] %}

        {% for event in changeEvents %}

            {% set rows = (rows.push({
                visuallyHiddenText: 'Select ' + event.eventReviewId,
                value: event.eventReviewId,
                selectable: event.acknowledgedBy === null,
                items: [
                    {
                        html: showProfileLink({
                            firstName: event.firstName,
                            middleNames: event.middleNames,
                            lastName: event.lastName,
                            prisonerNumber: event.prisonerNumber,
                            cellLocation: statusBasedCellLocation(event.cellLocation, event.prisonerStatus, event.prisonerPrisonCode == user.activeCaseLoadId),
                            inCaseLoad: event.prisonerPrisonCode == user.activeCaseLoadId
                        }),
                        attributes: {
                            "data-qa": "prisoner-details"
                        }
                    },
                    {
                        html: renderEventTypeTag(event),
                        classes: 'govuk-!-display-none-print'
                    },
                    {
                        text: event.eventTime | parseDate("yyyy-MM-dd'T'HH:mm:ss") | formatDate('HH:mm', false)
                    },
                    {
                        html: renderAllocations(event),
                        classes: 'govuk-!-display-none-print'
                    },
                    {
                        html: renderEventTypeLink(event),
                        classes: 'govuk-!-display-none-print'
                    }
                ]
            }), rows) %}

        {% endfor %}

        {% if rows.length == 0 %}
            <div class="govuk-body" data-qa="no-data-p">
                {% if isToday %}
                <p>There are no changes to show for today.</p>
                {% elif isYesterday %}
                <p>There are no changes to show for yesterday.</p>
                {% else %}
                <p>There are no changes to show for {{ date | formatDate('d MMMM yyyy') }}.</p>
                {% endif %}
                <p class="govuk-body"><a href="/activities/change-of-circumstances/select-period" data-qa="no-data-link">Select a different date</a></p>
            </div>
        {% else %}

            <form method='POST'>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="date" value="{{ date }}">
                <input type="hidden" name="page" value="{{ page }}">

                {{ mojPagination(pagination) }}

                {{ stickySelect({
                    type: 'check',
                    selectAllAvailable: true,
                    id: "changeEvents",
                    caption: "Change events",
                    captionClasses: "govuk-visually-hidden",
                    name: 'selectedEvents',
                    head: [
                        {
                            text: "Name"
                        },
                        {
                            text: "Change"
                        },
                        {
                            text: "Time"
                        },
                        {
                            text: "Allocations"
                        },
                        {
                            html: '<span class="govuk-visually-hidden">Actions</span>'
                        }
                    ],
                    rows: rows,
                    actions: [
                        {
                            text: 'Acknowledge',
                            formAction: 'view-changes'
                        }
                    ],
                    itemsDescription: 'event',
                    itemsDescriptionPlural: 'events'
                }) }}

                {{ mojPagination(pagination) }}
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}

{% macro renderEventTypeTag(event) %}
    {% set options = 
        ({ text: "Activities ended", classes: "govuk-tag--yellow" } if 'activities-changed' in event.eventType and event.eventDescription == 'ACTIVITY_ENDED') or
        ({ text: "Activities suspended", classes: "govuk-tag--yellow" } if 'activities-changed' in event.eventType and event.eventDescription == 'ACTIVITY_SUSPENDED') or
        ({ text: "Appointments kept", classes: "govuk-tag--yellow" } if 'appointments-changed' in event.eventType and event.eventDescription == 'APPOINTMENTS_KEPT') or
        ({ text: "Appointments cancelled", classes: "govuk-tag--yellow" } if 'appointments-changed' in event.eventType and event.eventDescription == 'APPOINTMENTS_CANCELLED') or
        ({ text: "Alert added", classes: "govuk-tag--grey" } if 'alerts-updated' in event.eventType and event.eventDescription == 'ALERT_ADDED') or
        ({ text: "Alert closed", classes: "govuk-tag--grey" } if 'alerts-updated' in event.eventType and event.eventDescription == 'ALERT_CLOSED') or
        ({ text: "Alerts have been added and removed", classes: "govuk-tag--grey" } if 'alerts-updated' in event.eventType and event.eventDescription == 'ALERTS_ADDED_AND_CLOSED') or
        ({ text: "Arrival or Return", classes: "govuk-tag--green" } if 'prisoner.received' in event.eventType) or
        ({ text: "Cell-move", classes: "govuk-tag--light-blue" } if 'cell.move' in event.eventType) or
        ({ text: "Cell-move", classes: "govuk-tag--light-blue" } if 'prisoner.updated' in event.eventType and event.eventDescription == 'CELL_MOVE') or
        ({ text: "Incentive level changed", classes: "govuk-tag--yellow" } if 'iep-review' in event.eventType) or
        ({ text: "Non-association", classes: "govuk-tag--orange" } if 'non-association' in event.eventType) or
        ({ text: "Release", classes: "govuk-tag--blue" } if ('prisoner.released' in event.eventType and event.eventDescription == 'RELEASED')) or
        ({ text: "Transfer out", classes: "govuk-tag--blue" } if ('prisoner.released' in event.eventType and event.eventDescription == 'TRANSFER_OUT')) or
        { text: "Unknown-event", classes: "govuk-tag--yellow"} %}

    {% set options = options | setAttribute('classes', options.classes + " govuk-!-font-size-16") %}

    {{ govukTag(options) }}
{% endmacro %}

{% macro renderEventTypeLink(event) %}
    {% set html = '' %}

    {% if 'non-association' in event.eventType %}
        {% set html = html +
            '<a href="/activities/prisoner-allocations/' + event.prisonerNumber +
            '/non-associations" class="govuk-link govuk-link--no-visited-state govuk-!-font-size-16">Non Associations</a><br>'
        %}
    {% endif %}

    {% if (
        'alerts-updated' in event.eventType or
        'iep-review' in event.eventType or
        'non-association' in event.eventType or
        'prisoner.received' in event.eventType or
        event.eventDescription == 'ACTIVITY_SUSPENDED' or
        ('prisoner.updated' in event.eventType and event.eventDescription == 'CELL_MOVE')
    ) and event.activeAllocations and event.activeAllocations.length %}
        {% set html = html +
            '<a href="/activities/prisoner-allocations/' + event.prisonerNumber +
            '" class="govuk-link govuk-link--no-visited-state govuk-!-font-size-16">Manage Allocations</a><br>'
        %}
    {% endif %}

    {% if 'alerts-updated' in event.eventType %}
        {% set html = html +
            '<a href="/prisoner/' + event.prisonerNumber +
            '/alerts/active" class="govuk-link govuk-link--no-visited-state govuk-!-font-size-16">View Alert Details</a><br>'
        %}
    {% endif %}

    {{ html | safe }}
{% endmacro %}

{% macro renderAllocations(event) %}
    {% if event.activeAllocations and event.activeAllocations.length %}
        {% for allocation in event.activeAllocations %}
            {{ allocation }}<br>
        {% endfor %}
    {% endif %}
{% endmacro %}
