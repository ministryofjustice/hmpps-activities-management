{% extends "layout.njk" %}

{% from "dps/components/alert-flag/macro.njk" import alertFlag %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "moj/components/pagination/macro.njk" import mojPagination %}
{% from "moj/components/sub-navigation/macro.njk" import mojSubNavigation %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "components/sticky-select.njk" import stickySelect %}
{% from "partials/showProfileLink.njk" import showProfileLink %}
{% from "partials/statusBasedCellLocation.njk" import statusBasedCellLocation %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}

{% set pageTitle = "Changes to review - Activities - DPS" %}
{% set pageId = 'change-of-circumstance-page' %}
{% set jsBackLink = true %}

{% block content %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full change-events">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-three-quarters">
                <span class="govuk-caption-m">Review changes in circumstances</span>
                <h1 class="govuk-heading-l govuk-!-margin-bottom-1">Changes to review</h1>
                <span class="govuk-caption-m govuk-!-margin-bottom-6">{{ date | formatDate('EEEE, d MMMM yyyy') }}</span>
                <p class="govuk-body">Review changes that may affect people’s allocations. Select ones you’ve reviewed, then mark them as reviewed to update the list.</p>
            </div>
        </div>


        {{ mojSubNavigation({
            label: 'Changes in circumstances',
            items: [
                { text: 'Changes to review', href: changesToReviewHref, active: not reviewed },
                { text: 'Changes that have been reviewed', href: reviewedChangesHref, active: reviewed }
            ]
        }) }}

        <form method="GET" class="change-filters">
            <input type="hidden" name="date" value="{{ date }}">
            {% if reviewed %}<input type="hidden" name="reviewed" value="true">{% endif %}
            <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Filter by</h2>
            <div class="change-filters__fields">
                {{ govukInput({
                    id: 'searchTerm', name: 'searchTerm', value: searchTerm,
                    label: { text: 'Name or prison number' }
                }) }}
                {{ govukCheckboxes({
                    name: 'changeTypes', idPrefix: 'changeTypes',
                    classes: 'govuk-checkboxes--small change-filters__checkboxes',
                    fieldset: { legend: { text: 'Changes to show' } },
                    items: filterItems
                }) }}
                <div class="change-filters__actions">
                    {{ govukButton({ text: 'Apply filters', classes: 'govuk-!-margin-bottom-0' }) }}
                    <a class="govuk-link" href="{{ clearFiltersHref }}">Clear</a>
                </div>
            </div>
        </form>

        {% set head = [
            { text: 'Prisoner', attributes: { 'aria-sort': 'none' } },
            { text: 'Change', attributes: { 'aria-sort': 'none' } },
            { text: 'Details' },
            { text: 'Time', attributes: { 'aria-sort': 'ascending' } },
            { text: 'Allocations' }
        ] %}

        {% if reviewed %}
            {% set head = (head.push({ text: 'Reviewed by' }), head) %}
        {% endif %}

        {% set head = (head.push({
            html: '<span class="govuk-visually-hidden">Actions</span>'
        }), head) %}
        {% set rows = [] %}
        {% for event in changeEvents %}
            {% set eventTypeTag = renderEventTypeTag(event) %}
            {% set allocationsHtml %}
                {% for allocation in event.activeAllocations %}
                    {{ allocation }}{% if not loop.last %}<br>{% endif %}
                {% else %}
                    None
                {% endfor %}
            {% endset %}
            {% set actionsHtml %}
                {% if event.eventDescription == 'NON_ASSOCIATION' %}
                    <a
                        class="govuk-link govuk-link--no-visited-state"
                        href="/activities/prisoner-allocations/{{ event.prisonerNumber }}/non-associations"
                    >
                        Non associations
                    </a><br>
                {% endif %}

                {% if (
                    event.eventDescription == 'ACTIVITY_SUSPENDED' or
                    event.eventDescription == 'CELL_MOVE' or
                    event.eventDescription == 'INCENTIVE_LEVEL_CHANGED' or
                    event.eventDescription == 'ARRIVAL_OR_RETURN' or
                    event.eventDescription == 'NON_ASSOCIATION' or
                    event.eventDescription == 'ALERT_ADDED' or
                    event.eventDescription == 'ALERT_CLOSED' or
                    event.eventDescription == 'ALERTS_ADDED_AND_CLOSED'
                ) and event.activeAllocations and event.activeAllocations.length %}
                    <a
                        class="govuk-link govuk-link--no-visited-state"
                        href="/activities/prisoner-allocations/{{ event.prisonerNumber }}"
                    >
                        Manage allocations
                        <span class="govuk-visually-hidden">
                            for {{ event | formatName(NameFormatStyle.firstLast) | forceescape }}
                        </span>
                    </a><br>
                {% endif %}

                {% if event.eventDescription in ['ALERT_ADDED', 'ALERT_CLOSED', 'ALERTS_ADDED_AND_CLOSED'] %}
                    <a
                        class="govuk-link govuk-link--no-visited-state"
                        href="{{ prisonerUrl }}/prisoner/{{ event.prisonerNumber }}/alerts/active"
                    >
                        View alert details
                    </a>
                {% endif %}
            {% endset %}
            
            {% set detailsText %}
                {% if event.eventDescription in [
                    'ACTIVITY_ENDED',
                    'ACTIVITY_SUSPENDED',
                    'APPOINTMENTS_CANCELLED',
                    'APPOINTMENTS_KEPT'
                ] %}

                    {{ '' }}

                {% elif event.eventDescription == 'ARRIVAL_OR_RETURN' %}

                    {{
                        event.eventData
                            | replace('_', ' ')
                            | lower
                            | title
                    }}

                {% elif event.eventDescription == 'RELEASED' %}

                    {{
                        event.eventData
                            | replace('_', ' ')
                            | lower
                            | title
                    }}

                {% elif event.eventDescription == 'TRANSFER_OUT' %}

                    {{
                        event.eventData
                            | replace('_', ' ')
                            | lower
                            | title
                    }}

                {% elif event.eventDescription == 'CELL_MOVE' %}
                    {% if event.prisonerUpdatedDetails.newCell or event.prisonerUpdatedDetails.previousCell %}
                         New cell: {{ event.prisonerUpdatedDetails.newCell }}
                         <br>
                         Previous Cell: {{ event.prisonerUpdatedDetails.previousCell }}
                     {% else %}
                         {{ event.eventData or '' }}
                     {% endif %}

                {% elif event.eventDescription == 'INCENTIVE_LEVEL_CHANGED' %}

                    Previous Level: {{ event.incentiveDetails.previousLevel }}
                    <br>
                    New Level: {{ event.incentiveDetails.newLevel }}

                {% elif event.eventDescription == 'ALERT_ADDED' %}
                    {% for alert in event.alertsAddedFlags %}
                        <div class="govuk-!-margin-bottom-1">
                            {{ alertFlag({
                                alert: alert
                            }) }}
                        </div>
                    {% endfor %}

                {% elif event.eventDescription == 'ALERT_CLOSED' %}

                    {% for alert in event.alertsClosedFlags %}
                        <div class="govuk-!-margin-bottom-1">
                            {{ alertFlag({
                                alert: alert
                            }) }}
                        </div>
                    {% endfor %}

                {% elif event.eventDescription == 'ALERTS_ADDED_AND_CLOSED' %}
                    {% if event.alertsAddedFlags.length %}
                        <div class="govuk-!-margin-bottom-1">
                            Added:
                        </div>

                        {% for alert in event.alertsAddedFlags %}
                            <div class="govuk-!-margin-bottom-1">
                                {{ alertFlag({
                                    alert: alert
                                }) }}
                            </div>
                        {% endfor %}
                    {% endif %}
                    {% if event.alertsClosedFlags.length %}
                        <div class="govuk-!-margin-top-2 govuk-!-margin-bottom-1">
                            Closed:
                        </div>

                        {% for alert in event.alertsClosedFlags %}
                            <div class="govuk-!-margin-bottom-1">
                                {{ alertFlag({
                                    alert: alert
                                }) }}
                            </div>
                        {% endfor %}
                    {% endif %}
                {% else %}
                    {{ event.eventData or '' }}
                {% endif %}
            {% endset %}

            {% set items = [
                {
                    html: showProfileLink({
                        firstName: event.firstName,
                        middleNames: event.middleNames,
                        lastName: event.lastName,
                        prisonerNumber: event.prisonerNumber,
                        cellLocation: statusBasedCellLocation(event.cellLocation, event.prisonerStatus, event.prisonerPrisonCode == user.activeCaseLoadId),
                        inCaseLoad: event.prisonerPrisonCode == user.activeCaseLoadId
                    }),
                    attributes: { 'data-qa': 'prisoner-details', 'data-sort-value': event | formatName(NameFormatStyle.lastCommaFirstMiddle, false) }
                },
                { html: eventTypeTag, attributes: { 'data-sort-value': eventTypeTag | striptags | trim } },
                { html: detailsText },
                {
                    text: event.eventTime | parseDate("yyyy-MM-dd'T'HH:mm:ss") | formatDate('HH:mm', false),
                    attributes: { 'data-sort-value': event.eventTime }
                },
                { html: allocationsHtml }
            ] %}
            {% if reviewed %}
                {% set items = (items.push({ text: event.acknowledgedBy }), items) %}
            {% endif %}

            {% set items = (items.push({ html: actionsHtml, classes: 'govuk-!-text-align-right' }), items) %}
            {% if reviewed %}
                {% set rows = (rows.push(items), rows) %}
            {% else %}
                {% set rows = (rows.push({
                    visuallyHiddenText: 'Select change for ' + (event | formatName(NameFormatStyle.firstLast) | forceescape),
                    value: event.eventReviewId,
                    selectable: true,
                    items: items
                }), rows) %}
            {% endif %}
        {% endfor %}

        {% if rows.length == 0 %}
            <p class="govuk-body" data-qa="no-data-p">
                {% if reviewed %}
                    No changes have been reviewed.{% if hasFilters %} Change your filter or search options.{% endif %}
                {% else %}
                    There are no changes to review.
                    {% if hasFilters %}Change your filter or search, or {% endif %}<a class="govuk-link" href="/activities/change-of-circumstances/select-period" data-qa="no-data-link">{{ 'select' if hasFilters else 'Select' }} a different date</a>.
                {% endif %}
            </p>
        {% else %}     
            {{ mojPagination(pagination) }}
            {% if reviewed %}
                {{ govukTable({
                    attributes: { 'data-module': 'moj-sortable-table', id: 'changeEvents' },
                    caption: 'Changes that have been reviewed',
                    captionClasses: 'govuk-visually-hidden',
                    head: head,
                    rows: rows
                }) }}
            {% else %}
                <form method="POST">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                    <input type="hidden" name="date" value="{{ date }}">
                    <input type="hidden" name="page" value="{{ page }}">
                    <input type="hidden" name="searchTerm" value="{{ searchTerm }}">
                    {% for filter in selectedFilters %}
                        <input type="hidden" name="changeTypes" value="{{ filter }}">
                    {% endfor %}
                    {{ stickySelect({
                        type: 'check',
                        selectAllAvailable: true,
                        id: 'changeEvents',
                        caption: 'Changes to review',
                        captionClasses: 'govuk-visually-hidden',
                        name: 'selectedEvents',
                        head: head,
                        rows: rows,
                        actions: [{ text: 'Mark as reviewed', formAction: 'view-changes' }],
                        itemsDescription: 'change',
                        itemsDescriptionPlural: 'changes'
                    }) }}
                </form>
            {% endif %}
            {{ mojPagination(pagination) }}
        {% endif %}
    </div>
</div>
{% endblock %}

{% macro renderEventTypeTag(event) %}
    {% set options =
        ({ text: "Activities ended", classes: "govuk-tag--yellow" }
            if event.eventDescription == 'ACTIVITY_ENDED') or

        ({ text: "Activities suspended", classes: "govuk-tag--yellow" }
            if event.eventDescription == 'ACTIVITY_SUSPENDED') or

        ({ text: "Appointments kept", classes: "govuk-tag--yellow" }
            if event.eventDescription == 'APPOINTMENTS_KEPT') or

        ({ text: "Appointments cancelled", classes: "govuk-tag--yellow" }
            if event.eventDescription == 'APPOINTMENTS_CANCELLED') or

        ({ text: "Alert added", classes: "govuk-tag--grey" }
            if event.eventDescription == 'ALERT_ADDED') or

        ({ text: "Alert closed", classes: "govuk-tag--grey" }
            if event.eventDescription == 'ALERT_CLOSED') or

        ({ text: "Alerts have been added and removed", classes: "govuk-tag--grey" }
            if event.eventDescription == 'ALERTS_ADDED_AND_CLOSED') or

        ({ text: "Arrival or return", classes: "govuk-tag--green" }
            if event.eventDescription == 'ARRIVAL_OR_RETURN'
            or 'prisoner.received' in event.eventType) or

        ({ text: "Cell move", classes: "govuk-tag--light-blue" }
            if event.eventDescription == 'CELL_MOVE') or

        ({ text: "Incentive level changed", classes: "govuk-tag--yellow" }
            if event.eventDescription == 'INCENTIVE_LEVEL_CHANGED'
            or 'iep-review' in event.eventType) or

        ({ text: "Non-association", classes: "govuk-tag--orange" }
            if event.eventDescription == 'NON_ASSOCIATION'
            or 'non-association' in event.eventType) or

        ({ text: "Release", classes: "govuk-tag--blue" }
            if event.eventDescription == 'RELEASED'
            or event.eventDescription == 'PERMANENT_RELEASE'
            or event.eventDescription == 'TEMPORARY_RELEASE') or

        ({ text: "Transfer out", classes: "govuk-tag--blue" }
            if event.eventDescription == 'TRANSFER_OUT') or

        { text: "Unknown event", classes: "govuk-tag--yellow" }
    %}

    {% set options = options | setAttribute(
        'classes',
        options.classes + ' govuk-!-font-size-16'
    ) %}

    {{ govukTag(options) }}
{% endmacro %}
