{% macro appointmentTypeCaption(appointmentJourney) %}
  {% if appointmentJourney.mode == AppointmentJourneyMode.EDIT %}
    <span class="govuk-caption-l" data-qa="caption">{{ appointmentJourney.appointmentName }}</span>
  {% elseif appointmentJourney.type == AppointmentType.SET %}
    <span class="govuk-caption-l" data-qa="caption">Schedule a set of back-to-backs</span>
  {% else %}
    <span class="govuk-caption-l" data-qa="caption">Schedule an appointment</span>
  {% endif %}
{% endmacro %}
