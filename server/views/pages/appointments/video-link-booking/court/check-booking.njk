{% extends "layout.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "partials/showProfileLink.njk" import showProfileLink %}
{% from "partials/video-link-booking/formatCvpLink.njk" import formatCvpLink %}

{% set pageTitle = "Check and confirm appointment details" %}
{% set pageId = 'appointment-check-answers-page' %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

            <form method="POST" data-module="form-spinner" data-loading-text="Preparing your appointments">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

                <h2 class="govuk-heading-m">Appointment details</h2>
                {{ govukSummaryList({
                    rows: [
                        {
                            key: {
                                text: "Appointment name"
                            },
                            value: {
                                text: "Video Link - Court Hearing"
                            }
                        },
                        {
                            key: {
                                text: "Name of attendee"
                            },
                            value: {
                                html: showProfileLink({
                                    firstName: bookACourtHearingJourney.prisoner.firstName,
                                    middleNames: bookACourtHearingJourney.prisoner.middleNames,
                                    lastName: bookACourtHearingJourney.prisoner.lastName,
                                    prisonerNumber: bookACourtHearingJourney.prisoner.number,
                                    cellLocation: bookACourtHearingJourney.prisoner.cellLocation
                                })
                            }
                        },
                        {
                            key: {
                                text: "Court"
                            },
                            value: {
                                text: (courts | find('code', bookACourtHearingJourney.courtCode)).description
                            },
                            actions: {
                                items: [
                                    {
                                        href: "hearing-details?preserveHistory=true",
                                        text: "Change",
                                        visuallyHiddenText: "change court",
                                        classes: "govuk-link--no-visited-state",
                                        attributes: { 'data-qa': 'change-court' }
                                    }
                                ]
                            }
                        },
                        {
                            key: {
                                text: "Hearing type"
                            },
                            value: {
                                text: (hearingTypes | find('code', bookACourtHearingJourney.hearingTypeCode)).description
                            },
                            actions: {
                                items: [
                                    {
                                        href: "hearing-details?preserveHistory=true",
                                        text: "Change",
                                        visuallyHiddenText: "change hearing type",
                                        classes: "govuk-link--no-visited-state",
                                        attributes: { 'data-qa': 'change-hearing-type' }
                                    }
                                ]
                            }
                        },
                        {
                            key: {
                                text: "Court hearing link"
                            },
                            value: {
                                text: formatCvpLink(bookACourtHearingJourney.hmctsNumber, bookACourtHearingJourney.videoLinkUrl)
                            },
                            actions: {
                                items: [
                                    {
                                        href: "court-hearing-link?preserveHistory=true",
                                        text: "Change",
                                        visuallyHiddenText: "change court video link",
                                        classes: "govuk-link--no-visited-state"
                                    }
                                ]
                            }
                        },
                        {
                            key: {
                                text: "Guest pin"
                            },
                            value: {
                                text: bookACourtHearingJourney.guestPin or "Not required"
                            },
                            actions: {
                                items: [
                                    {
                                        href: "court-hearing-link?preserveHistory=true",
                                        text: "Change",
                                        visuallyHiddenText: "change guestPin",
                                        classes: "govuk-link--no-visited-state"
                                    }
                                ]
                            }
                        }
                    ],
                    attributes: { 'data-qa': 'appointment-details' }
                }) }}

                <h2 class="govuk-heading-m">Scheduling information</h2>
                {{ govukSummaryList({
                    card: {
                        title: {
                            text: "Pre-court hearing"
                        },
                        actions: {
                            items: [
                                {
                                    href: "date-and-time?preserveHistory=true",
                                    text: "Change",
                                    visuallyHiddenText: "pre-court hearing",
                                    classes: "govuk-link--no-visited-state"
                                }
                            ]
                        }
                    },
                    rows: [
                        {
                            key: {
                                text: "Location"
                            },
                            value: {
                                text: (rooms | find('dpsLocationId', bookACourtHearingJourney.preLocationId)).description
                            }
                        },
                        {
                            key: {
                                text: "Start time"
                            },
                            value: {
                                text: bookACourtHearingJourney.preHearingStartTime | parseISODate | formatDate('HH:mm')
                            }
                        },
                        {
                            key: {
                                text: "End time"
                            },
                            value: {
                                text: bookACourtHearingJourney.preHearingEndTime | parseISODate | formatDate('HH:mm')
                            }
                        }
                    ] if bookACourtHearingJourney.preLocationId else [{ value: { text: "No pre-court hearing" } }],
                    classes: "govuk-summary-list govuk-summary-list--no-keys" if not bookACourtHearingJourney.preLocationId,
                    attributes: { 'data-qa': 'pre-scheduling-information' }
                }) }}

                {{ govukSummaryList({
                    card: {
                        title: {
                            text: "Main hearing"
                        }
                    },
                    rows: [
                        {
                            key: {
                                text: "Location"
                            },
                            value: {
                                text: (rooms | find('dpsLocationId', bookACourtHearingJourney.locationId)).description
                            },
                            actions: {
                                items: [
                                    {
                                        href: "location?preserveHistory=true",
                                        text: "Change",
                                        visuallyHiddenText: "change location",
                                        classes: "govuk-link--no-visited-state",
                                        attributes: { 'data-qa': 'change-location' }
                                    }
                                ]
                            }
                        },
                        {
                            key: {
                                text: "Date"
                            },
                            value: {
                                text: bookACourtHearingJourney.date | parseISODate | formatDate
                            },
                            actions: {
                                items: [
                                    {
                                        href: "date-and-time?preserveHistory=true",
                                        text: "Change",
                                        visuallyHiddenText: "change date",
                                        classes: "govuk-link--no-visited-state",
                                        attributes: { 'data-qa': 'change-date' }
                                    }
                                ]
                            }
                        },
                        {
                            key: {
                                text: "Start time"
                            },
                            value: {
                                text: bookACourtHearingJourney.startTime | parseISODate | formatDate('HH:mm')
                            },
                            actions: {
                                items: [
                                    {
                                        href: "date-and-time?preserveHistory=true",
                                        text: "Change",
                                        visuallyHiddenText: "change start time",
                                        classes: "govuk-link--no-visited-state",
                                        attributes: { 'data-qa': 'change-start-time' }
                                    }
                                ]
                            }
                        },
                        {
                            key: {
                                text: "End time"
                            },
                            value: {
                                text: bookACourtHearingJourney.endTime | parseISODate | formatDate('HH:mm')
                            },
                            actions: {
                                items: [
                                    {
                                        href: "date-and-time?preserveHistory=true",
                                        text: "Change",
                                        visuallyHiddenText: "change end time",
                                        classes: "govuk-link--no-visited-state",
                                        attributes: { 'data-qa': 'change-end-time' }
                                    }
                                ]
                            }
                        }
                    ],
                    attributes: { 'data-qa': 'main-scheduling-information' }
                }) }}

                {{ govukSummaryList({
                    card: {
                        title: {
                            text: "Post-court hearing"
                        },
                        actions: {
                            items: [
                                {
                                    href: "date-and-time?preserveHistory=true",
                                    text: "Change",
                                    visuallyHiddenText: "post-court hearing",
                                    classes: "govuk-link--no-visited-state"
                                }
                            ]
                        }
                    },
                    rows: [
                        {
                            key: {
                                text: "Location"
                            },
                            value: {
                                text: (rooms | find('dpsLocationId', bookACourtHearingJourney.postLocationId)).description
                            }
                        },
                        {
                            key: {
                                text: "Start time"
                            },
                            value: {
                                text: bookACourtHearingJourney.postHearingStartTime | parseISODate | formatDate('HH:mm')
                            }
                        },
                        {
                            key: {
                                text: "End time"
                            },
                            value: {
                                text: bookACourtHearingJourney.postHearingEndTime | parseISODate | formatDate('HH:mm')
                            }
                        }
                    ] if bookACourtHearingJourney.postLocationId else [{ value: { text: "No post-court hearing" } }],
                    classes: "govuk-summary-list govuk-summary-list--no-keys" if not bookACourtHearingJourney.postLocationId,
                    attributes: { 'data-qa': 'post-scheduling-information' }
                }) }}

                {{ govukSummaryList({
                    card: {
                        title: {
                            text: "Extra information"
                        },
                        actions: {
                            items: [
                                {
                                    href: "extra-information?preserveHistory=true",
                                    text: "Change",
                                    visuallyHiddenText: "extra information",
                                    classes: "govuk-link--no-visited-state",
                                    attributes: { 'data-qa': 'change-extra-information' }
                                }
                            ]
                        }
                    },
                    rows: [
                        {
                            key: {
                                text: 'Notes for prison staff'
                            },
                            value: {
                                html: '<span class="preserve-line-breaks">' + (bookACourtHearingJourney.notesForStaff or 'None entered' | escape) + '</span>'
                            }
                        },
                        {
                            key: {
                                text: "Notes for prisoner"
                            },
                            value: {
                                html: '<span class="preserve-line-breaks">' + (bookACourtHearingJourney.notesForPrisoners or 'None entered' | escape) + '</span>'
                            }
                        }
                    ],
                    attributes: { 'data-qa': 'extra-information' }
                }) }}

                <div class="govuk-button-group">
                    {{ govukButton({
                        text: "Confirm",
                        preventDoubleClick: true
                    }) }}
                </div>
            </form>
        </div>
    </div>
{% endblock %}



